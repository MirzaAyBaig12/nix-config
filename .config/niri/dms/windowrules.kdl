// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^com\\.danklinux\\.dms$"
    opacity 1.00
}

window-rule {
    match app-id="^openscreen$"

    border {
        off
    }

    focus-ring {
        off
    }
}

window-rule {
    match app-id="^hydralauncher$"
    open-maximized true
}