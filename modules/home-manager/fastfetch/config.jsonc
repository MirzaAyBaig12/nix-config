//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  GROUPS
//
//  by Bina

  
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "nixos",
    	"type": "auto",
      	"padding": {
    		"top": 1
      	},
      	"color": {
    		"1": "#6d28d9",
    		"2": "#a78bfa",
    		"3": "#6d28d9",
    		"4": "#a78bfa", 
    		"5": "#6d28d9",
    		"6": "#a78bfa"
      	}
    },
    "display": {
          "separator": " ➜  ",
          "percent": {
              "color": {
                  "green": "#d8b4fe",
                  "yellow": "#c084fc",
                  "red": "#a855f7"
              }
          }
    },
    "modules": [
        "break",
        "break",
        "break",
         {
            "type": "os",
            "key": " DISTRO",
            "keyColor": "#d8b4fe",  // = color1
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "#d8b4fe",
        },
        {
            "type": "packages",
            "format": "{31} (pacman), {49} (flatpak), {48} (brew)",
            "key": " ├ 󰏖 ",
            "keyColor": "#d8b4fe",  
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "#d8b4fe", 
        },
        "break",
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "#c084fc", 
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "#c084fc",
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "#c084fc",
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "#c084fc", 
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "#c084fc",
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "#c084fc", 
        },
        "break",
        {
            "type": "host",
            "format": "{2}",
            "key": "󰌢 SYSTEM",
            "keyColor": "#a855f7",
        },
        {
            "type": "cpu",
            "format": "Intel Core i7-1255U ({3}) @ {7}",
            "key": " ├  ",
            "keyColor": "#a855f7",
        },
        {
            "type": "gpu",
            "format": "{1} {2} @ {12} GHz",            
            "key": " ├ 󰢮 ",
            "keyColor": "#a855f7",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "#a855f7",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "#a855f7",
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "#a855f7",
        },
        {
            "type": "monitor",
            "format": "{inch}in {width}x{height} @ {refresh-rate}Hz",
            "key": " └  ",
            "keyColor": "#a855f7",
        },
        "break",
        "break",
    ]
}
