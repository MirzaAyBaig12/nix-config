/* ----------- 💫 https://github.com/JaKooLit 💫 -------- */

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "nixos",
        "padding": {
            "top": 2,
            "right": 2
        },
        "type": "small",
        "color": {
            "1": "#a78bfa",
            "2": "#7c3aed",
            "3": "#5b21b6",
            "4": "#c4b5fd",
            "5": "#4c1d95"
        }
    },
    "display": {
        "separator": " -> ",
        "percent": {
            "color": {
                "green": "#d8b4fe",
                "yellow": "#c084fc",
                "red": "#a855f7"
            }
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "keyWidth": 10,
			"format": "      {6}{7}{8} "
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },    
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "#a78bfa"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "#7c3aed"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "#a78bfa"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "#5b21b6"
        },
        /*
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "#a78bfa"
        },
        */
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "#7c3aed",
            // format: used / total
            "format": "{1} / {2}"
        },
        {
            "type": "uptime",
            "key": "󰔛 ",
            "keyColor": "#c4b5fd"
        },
        {
            "type": "command",
            "key": "󱦟 ",
            "keyColor": "#7c3aed",
            "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },
        {
            "type": "custom",
            "format": "   \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[90m "
        },
		"break",
		"break"
    ]
}
